# Copy this file to .env (and to server/src/.env if you prefer that location)
# and fill in real values. Never commit the real .env file.

# Local dev server port (unused on Vercel — it assigns its own)
PORT=8080

# Comma-separated extra origins allowed to call the API (only needed if the
# frontend and backend are deployed as separate domains). Same-origin
# deployments — the default for this project — don't need this set.
ALLOWED_ORIGIN=

# Supabase Postgres connection string — use the "Connection pooling" /
# "Transaction" mode URI from Project Settings > Database, e.g.:
# postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Secret code staff use to log into /dashboard. Generate a long random value,
# e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
