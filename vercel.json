{
  "version": 2,
  "builds": [
    { "src": "server/src/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/src/index.js" },
    { "src": "/health", "dest": "server/src/index.js" },
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/script.js", "dest": "/public/script.js" },
    { "src": "/images/(.*)", "dest": "/public/images/$1" },
    { "src": "/dashboard", "dest": "/public/dashboard.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
